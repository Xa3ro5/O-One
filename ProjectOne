-- Load the shared SmugLibCoreV2 base and let it complete initialization.
local function loadSmugLibrary()
    local url="https://raw.githubusercontent.com/Xa3ro5/LifeIsRoblox/refs/heads/main/SmugLibCoreV2.lua"
    local freshUrl=url.."?smuglib="..game:GetService("HttpService"):GenerateGUID(false)
    local ok,source=pcall(game.HttpGet,game,freshUrl,true)
    assert(ok and type(source)=="string" and source~="","Failed to download SmugLib V2.")
    local factory,compileError=loadstring(source)
    assert(factory,compileError or "Failed to compile SmugLib V2.")
    return factory()
end

-- Read-only CollectionService registry; GUI and adornments are the only owned instances.
local function createObjectESP(app,C,win,overlay,highlightFolder,helpers)
    local CS=game:GetService("CollectionService")
    local Players=game:GetService("Players")
    local localPlayer=Players.LocalPlayer
    local make,text,labelAt,connect=helpers.make,helpers.text,helpers.labelAt,helpers.connect
    local categoryOrder={"Mines & traps","Cameras","Drones","Explosives","Grenades","Objectives","Barriers"}
    local categoryTypes={
        ["Mines & traps"]={"NeedleMine","Claymore","ProximityAlarm","BarbedWire"},
        ["Cameras"]={"DefaultCamera","DefaultCameraHack","BulletproofCamera","StickyCamera"},
        ["Drones"]={"Drone"},
        ["Explosives"]={"RemoteC4","BreachCharge","HardBreachCharge","ThermiteCharge","ToxicCharge","IncendiaryCanister"},
        ["Grenades"]={"FragGrenade","ImpactGrenade","StunGrenade","SmokeGrenade","EMPGrenade","IncendiaryGrenade","LaunchedGrenade","Thrown","Throwable"},
        ["Objectives"]={"Bomb","Defuser","Zone","EndMatchZone","SpawnZone"},
        ["Barriers"]={"DeployableShield","Shield","MetalShield","GlassShield","BarricadeItem","DoorBarricade","MetalBarricade","ReinforceItem","Reinforcement"},
    }
    local lookup,types={},{}
    local categoryColor={
        ["Mines & traps"]="FF8066",["Cameras"]="6FCBF3",["Drones"]="A5AFFA",["Explosives"]="FF626E",
        ["Grenades"]="F3AC68",["Objectives"]="F6D575",["Barriers"]="91A8B9",
    }
    for _,category in ipairs(categoryOrder) do for _,tag in ipairs(categoryTypes[category]) do lookup[tag]=category;types[tag]=true end end
    local ruleDefault={enabled=false,color="FFFFFF",labels=true,showDistance=true,showHealth=false,
        showOwner=false,chams=true,fill=78,outline=5,depth="Through walls",filter="All",scale=12,hideDestroyed=true}
    local numberRanges={fill={0,100},outline={0,100},scale={10,18}}
    local function validated(key,value)
        value=helpers.normalize(value)
        if ruleDefault[key]==nil then return nil end
        if type(ruleDefault[key])=="boolean" then if type(value)=="boolean" then return value end
        elseif numberRanges[key] then
            if type(value)=="number" and value==value and math.abs(value)~=math.huge then return math.clamp(value,numberRanges[key][1],numberRanges[key][2]) end
        elseif key=="color" then return type(value)=="string" and value:gsub("#",""):match("^%x%x%x%x%x%x$") or nil
        elseif key=="depth" then return table.find({"Through walls","Visible only"},value) and value or nil
        elseif key=="filter" then return table.find({"All","Other owners","Owned","Unowned"},value) and value or nil end
        return nil
    end
    local raw=type(C.objectRules)=="table" and C.objectRules or {}
    local rules={};C.objectRules=rules
    local function loadRule(id,category,inherit)
        local r=inherit and setmetatable({},{__index=inherit}) or table.clone(ruleDefault)
        if not inherit then r.color=categoryColor[category] end
        if type(raw[id])=="table" then
            for key,value in pairs(raw[id]) do local v=validated(key,value);if v~=nil then r[key]=v end end
        end
        rules[id]=r;return r
    end
    for _,category in ipairs(categoryOrder) do loadRule("@"..category,category) end
    for tag in pairs(types) do if raw[tag] then loadRule(tag,lookup[tag],rules["@"..lookup[tag]]) end end
    local registry,visuals,counts={}, {}, {}
    local candidates={};local cacheClock=1;local tagClock=0
    local object={registry=registry,visuals=visuals,counts=counts,rules=rules,categoryOrder=categoryOrder,types=types}
    app.objectESP=object
    local function ruleFor(tag) return rules[tag] or rules["@"..lookup[tag]] end
    local function isWorld(instance)
        if not instance:IsDescendantOf(workspace) then return false end
        local viewmodels=workspace:FindFirstChild("Viewmodels")
        if viewmodels and instance:IsDescendantOf(viewmodels) then return false end
        local cubicle=workspace:FindFirstChild("LoadoutCubicle")
        if cubicle and instance:IsDescendantOf(cubicle) then return false end
        local camera=workspace.CurrentCamera
        if camera and instance:IsDescendantOf(camera) then return false end
        if instance:FindFirstChildOfClass("Humanoid") then return false end
        for _,player in ipairs(Players:GetPlayers()) do
            if player.Character and instance:IsDescendantOf(player.Character) then return false end
        end
        return instance:IsA("Model") or instance:IsA("BasePart")
    end
    local function priority(tag)
        if tag=="Throwable" or tag=="Thrown" then return 1 end
        return 3
    end
    local function register(instance,tag)
        if not isWorld(instance) then return end
        local e=registry[instance]
        if not e or priority(tag)>priority(e.tag) then registry[instance]={instance=instance,tag=tag} end
    end
    local function refresh(full)
        if full then for tag in pairs(types) do for _,instance in ipairs(CS:GetTagged(tag)) do register(instance,tag) end end end
        table.clear(counts)
        for instance,e in pairs(registry) do
            if not instance:IsDescendantOf(workspace) or not CS:HasTag(instance,e.tag) then
                registry[instance]=nil
            else counts[e.tag]=(counts[e.tag] or 0)+1 end
        end
        for instance,v in pairs(visuals) do
            if not registry[instance] then v.label:Destroy();if v.highlight then v.highlight:Destroy() end;visuals[instance]=nil end
        end
    end
    function object:Refresh() refresh(true);cacheClock=1 end
    local function ownerOf(instance)
        local owner=instance:GetAttribute("Owner") or instance:GetAttribute("UserId")
        if owner==nil then
            local state=instance:FindFirstChild("StateObject")
            local value=state and state:FindFirstChild("owner")
            if value and value:IsA("ObjectValue") and value.Value and value.Value:IsA("Player") then return value.Value.UserId,value.Value.Name end
        end
        if type(owner)=="number" then
            local p=Players:GetPlayerByUserId(owner);return owner,p and p.Name or tostring(owner)
        elseif type(owner)=="string" then return tonumber(owner),owner end
        return nil,nil
    end
    local function positionOf(instance)
        if instance:IsA("BasePart") then return instance.Position end
        local part=instance.PrimaryPart or instance:FindFirstChild("Root") or instance:FindFirstChildWhichIsA("BasePart",true)
        return part and part.Position or nil
    end
    local function hideAll(destroy)
        for _,v in pairs(visuals) do
            v.label.Visible=false;v.activeChams=false
            if v.highlight then
                if destroy then v.highlight:Destroy();v.highlight=nil else v.highlight.Enabled=false end
            end
        end
    end
    function object:Hide() hideAll(true) end
    function object:ChamsDemand()
        local count=0
        for i=1,math.min(#candidates,C.objectLimit) do if candidates[i].rule.chams and candidates[i].rule.enabled then count+=1 end end
        return count
    end
    local function select(camera)
        table.clear(candidates)
        for instance,e in pairs(registry) do
            local r=ruleFor(e.tag)
            if r.enabled and isWorld(instance) then
                -- A more specific tagged parent already covers its own component parts.
                local parent=registry[instance.Parent]
                if not parent or not ruleFor(parent.tag).enabled then
                    local health=instance:GetAttribute("Health")
                    local ownerId,ownerName=ownerOf(instance)
                    local allowed=not (r.hideDestroyed and type(health)=="number" and health<=0)
                    if r.filter=="Other owners" and (ownerId==nil or ownerId==localPlayer.UserId) then allowed=false end
                    if r.filter=="Owned" and ownerId~=localPlayer.UserId then allowed=false end
                    if r.filter=="Unowned" and ownerId~=nil then allowed=false end
                    local pos=allowed and positionOf(instance)
                    if pos then
                        local distance=(pos-camera.CFrame.Position).Magnitude
                        table.insert(candidates,{e=e,rule=r,distance=distance,health=health,owner=ownerName,color=Color3.fromHex(r.color)})
                    end
                end
            end
        end
        table.sort(candidates,function(a,b)return a.distance<b.distance end)
    end
    function object:Render(camera,dt,budget)
        cacheClock+=dt;tagClock+=dt
        if tagClock>=2 then tagClock=0;refresh(false) end
        if cacheClock>=0.2 then cacheClock=0;select(camera) end
        hideAll()
        local count,used=0,0
        local occupied={}
        for i=1,math.min(#candidates,C.objectLimit) do
            local q=candidates[i];local e,r=q.e,q.rule;local instance=e.instance
            if instance:IsDescendantOf(workspace) and r.enabled then
                local pos=positionOf(instance)
                local distance=pos and (pos-camera.CFrame.Position).Magnitude or math.huge
                if pos then
                    local projected,onScreen=camera:WorldToViewportPoint(pos)
                    local v=visuals[instance]
                    if not v then
                        v={label=text(overlay,r.scale),lastUsed=os.clock()};visuals[instance]=v
                    end
                    v.lastUsed=os.clock()
                    local color=q.color
                    if onScreen and r.labels then
                        local cell=math.floor(projected.X/150)..":"..math.floor(projected.Y/28)
                        local lane=occupied[cell] or 0;occupied[cell]=lane+1
                        local pieces={e.tag}
                        if r.showDistance then table.insert(pieces,string.format("%.0f studs",distance)) end
                        if r.showHealth and type(q.health)=="number" then table.insert(pieces,string.format("HP %.0f",q.health)) end
                        if r.showOwner and q.owner then table.insert(pieces,"@"..q.owner) end
                        local vp=camera.ViewportSize
                        local px=math.clamp(projected.X,100,math.max(100,vp.X-100))
                        local py=math.clamp(projected.Y+(C.objectDeclutter and lane*(r.scale+4) or 0),14,math.max(14,vp.Y-16))
                        labelAt(v.label,table.concat(pieces," · "),px,py,color,C.opacity/100,300)
                        if C.objectDeclutter and lane>3 then v.label.Visible=false end
                        v.label.TextSize=r.scale
                    end
                    if r.chams and used<budget then
                        if not v.highlight then v.highlight=make("Highlight",{Name="Object_"..e.tag,Enabled=false},highlightFolder) end
                        local h=v.highlight;h.Adornee=instance;h.FillColor=color;h.OutlineColor=color
                        h.FillTransparency=r.fill/100;h.OutlineTransparency=r.outline/100
                        h.DepthMode=r.depth=="Visible only" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
                        h.Enabled=true;v.activeChams=true;used+=1
                    elseif v.highlight then v.highlight:Destroy();v.highlight=nil end
                    count+=1
                end
            end
        end
        for instance,v in pairs(visuals) do
            if v.highlight and not v.activeChams then v.highlight:Destroy();v.highlight=nil end
            if os.clock()-v.lastUsed>2 then v.label:Destroy();if v.highlight then v.highlight:Destroy() end;visuals[instance]=nil end
        end
        app.stats.objects=count;app.stats.objectCandidates=#candidates;app.stats.objectChams=used
    end
    local controls={}
    app.objectCategoryControls={}
    -- Old per-type switches must not contradict the new category switches.
    for tag in pairs(types) do
        if rules[tag] then
            for _,key in ipairs({"enabled","chams","labels","showDistance","showHealth","showOwner","hideDestroyed","filter","depth","fill","outline"}) do rules[tag][key]=nil end
        end
    end
    for _,category in ipairs(categoryOrder) do rules["@"..category].filter="All" end
    local function sync()
        for _,binding in ipairs(controls) do binding.control:Set(binding.get()) end
    end
    function app:SetObjectRule(id,key,value)
        id=helpers.normalize(id)
        local category=lookup[id] or (id:sub(1,1)=="@" and table.find(categoryOrder,id:sub(2)) and id:sub(2))
        local v=validated(key,value)
        if not category or v==nil then return false end
        if not rules[id] then rules[id]=setmetatable({},{__index=rules["@"..category]}) end
        rules[id][key]=v
        if id:sub(1,1)=="@" then
            for _,tag in ipairs(categoryTypes[category]) do if rules[tag] then rules[tag][key]=nil end end
        end
        cacheClock=1;sync();return true
    end
    function app:ObjectSnapshot()
        return {counts=table.clone(counts),shown=self.stats.objects or 0,candidates=self.stats.objectCandidates or 0,chams=self.stats.objectChams or 0}
    end
    function object:Reset()
        for _,category in ipairs(categoryOrder) do
            local r=table.clone(ruleDefault);r.color=categoryColor[category];rules["@"..category]=r
            for _,tag in ipairs(categoryTypes[category]) do rules[tag]=nil end
        end
        cacheClock=1;hideAll(true);sync()
    end
    local function categoryToggle(section,category,key,title)
        local function get()return rules["@"..category][key]end
        local control=section:Toggle(title,function(on)app:SetObjectRule("@"..category,key,on)end,get())
        table.insert(controls,{control=control,get=get})
        app.objectCategoryControls[category]=app.objectCategoryControls[category] or {}
        app.objectCategoryControls[category][key]=control
    end
    local function globalToggle(section,title,key,onValue,offValue)
        if onValue==nil then onValue=true;offValue=false end
        local function get()
            for _,category in ipairs(categoryOrder) do if rules["@"..category][key]~=onValue then return false end end
            return true
        end
        local control=section:Toggle(title,function(on)
            local value=offValue;if on then value=onValue end
            for _,category in ipairs(categoryOrder) do app:SetObjectRule("@"..category,key,value) end
        end,get())
        table.insert(controls,{control=control,get=get})
    end
    local tab=win:Folder("Objects")
    local selection=tab:Section("WHAT TO SHOW")
    selection:Label("Enable the categories you need. Range is unlimited.")
    for _,category in ipairs(categoryOrder) do categoryToggle(selection,category,"enabled",category) end
    local chams=tab:Section("CHAMS BY CATEGORY")
    for _,category in ipairs(categoryOrder) do categoryToggle(chams,category,"chams",category) end
    local visual=tab:Section("OBJECT APPEARANCE")
    globalToggle(visual,"Chams through walls","depth","Through walls","Visible only")
    globalToggle(visual,"Filled chams","fill",78,100)
    globalToggle(visual,"Chams outlines","outline",5,100)
    local labels=tab:Section("OBJECT LABELS")
    globalToggle(labels,"Names","labels")
    globalToggle(labels,"Distance","showDistance")
    globalToggle(labels,"Object health","showHealth")
    globalToggle(labels,"Owner","showOwner")
    globalToggle(labels,"Hide destroyed objects","hideDestroyed")
    for tag in pairs(types) do
        connect(CS:GetInstanceAddedSignal(tag),function(instance)register(instance,tag);cacheClock=1 end)
        connect(CS:GetInstanceRemovedSignal(tag),function(instance)
            local e=registry[instance];if e and e.tag==tag then registry[instance]=nil end;cacheClock=1
        end)
    end
    connect(workspace.DescendantAdded,function(instance)
        if instance:IsA("Model") or instance:IsA("BasePart") then
            for _,tag in ipairs(CS:GetTags(instance)) do if types[tag] then register(instance,tag) end end
        end
    end)
    refresh(true)
    return object
end

-- ForceFields are observed protection; spawn windows are explicitly estimates.
local function createProtection()
    local records=setmetatable({},{__mode="k"})
    local modes={}
    local ok,globals=pcall(function()return require(game.ReplicatedStorage.Modules.Globals)end)
    if ok and type(globals)=="table" then modes=globals.gamemodes or {} end
    local connection=workspace.ChildAdded:Connect(function(model)
        if not model:IsA("Model") then return end
        local mode=modes[workspace:GetAttribute("Gamemode")]
        local duration=mode and mode.spawn_protection_seconds
        if type(duration)=="number" and duration>0 then records[model]={deadline=os.clock()+duration} end
    end)
    local tracker={}
    function tracker:Get(char)
        if not char or not char.Parent then return false,nil,false end
        local field=char:FindFirstChildOfClass("ForceField")
        local record=records[char]
        local remaining=record and math.max(0,record.deadline-os.clock()) or nil
        if remaining and remaining>0 then return true,remaining,true end
        -- An existing/permanent ForceField has no known expiry. Loading the
        -- script never resets a countdown for a previously existing character.
        return field~=nil,nil,false
    end
    function tracker:Unload()connection:Disconnect();table.clear(records)end
    return tracker
end

