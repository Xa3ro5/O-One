-- Operation One adapter: redirect only the native local Gun:send_shoot look.
-- Preserve native shots, ammunition, ray damage and replication.
local function createSilentAim(app,win,overlay,helpers)
    local Players=game:GetService("Players")
    local UIS=game:GetService("UserInputService")
    local localPlayer=Players.LocalPlayer
    local make=helpers.make
    local settings={fov=150,chance=100,hitbox="Head",priority="Crosshair",
        visibleOnly=true,ignoreFriends=false,ignoreProtected=true,sticky=true,
        holdRMB=false,adsOnly=false,showFov=true,showTarget=true,
        noRecoil=false,noSpread=false,shotTrails=true}
    local aim={enabled=false,ready=false,settings=settings,target=nil,error=nil,
        stats={shots=0,completed=0,failed=0,rays=0,trails=0,lookCalls=0,scopedLooks=0,redirected=0,missedChance=0,candidates=0},generation=0}
    app.silentAim=aim
    local module,originalSend,originalLook,wrappedSend,wrappedLook
    local originalRay,wrappedRay,originalKick,wrappedKick
    local bridge
    local scopes=setmetatable({},{__mode="k"})
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.IgnoreWater=true
    local ring=make("Frame",{Name="SilentAimFOV",AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundTransparency=1,Visible=false,ZIndex=8},overlay)
    make("UICorner",{CornerRadius=UDim.new(1,0)},ring)
    local stroke=make("UIStroke",{Color=Color3.fromRGB(101,229,181),Thickness=1,Transparency=0.3},ring)
    local marker=make("Frame",{Name="SilentAimTarget",AnchorPoint=Vector2.new(0.5,0.5),
        Size=UDim2.fromOffset(8,8),BackgroundTransparency=1,Visible=false,ZIndex=9},overlay)
    make("UICorner",{CornerRadius=UDim.new(1,0)},marker)
    make("UIStroke",{Color=Color3.fromRGB(255,204,110),Thickness=1.5},marker)
    local function aliveCharacter(char,player)
        if not char or not char:IsDescendantOf(workspace) then return false end
        local state=char:FindFirstChild("StateObject")
        local owner=state and state:FindFirstChild("owner")
        local clean=state and state:FindFirstChild("clean")
        local hum=char:FindFirstChildOfClass("Humanoid")
        return owner and owner:IsA("ObjectValue") and owner.Value==player
            and clean and clean:IsA("BoolValue") and not clean.Value
            and hum and hum.Health>0
    end
    local function ownsWeapon(weapon)
        if type(weapon)~="table" then return false end
        local owner=weapon.owner
        return type(owner)=="table" and type(owner.values)=="table"
            and owner.values.equipped==weapon and aliveCharacter(owner.instance,localPlayer)
    end
    local function activeInput()
        return app.alive and aim.enabled and aim.ready and (not helpers.allowed or helpers.allowed())
            and not UIS:GetFocusedTextBox()
            and (not settings.holdRMB or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
    end
    local function wanted()return aim.enabled or settings.noRecoil or settings.noSpread end
    local function weaponActive()
        return app.alive and aim.ready and wanted() and (not helpers.allowed or helpers.allowed())
    end
    local function visible(origin,position,entry,localChar,camera)
        local ignore={camera}
        if localChar then table.insert(ignore,localChar) end
        local folder=workspace:FindFirstChild("Viewmodels")
        local root=localChar and localChar:FindFirstChild("HumanoidRootPart")
        if folder and root then
            for _,rig in ipairs(folder:GetChildren()) do
                local torso=rig:FindFirstChild("torso")
                local motor=torso and torso:FindFirstChild("JointMotor")
                if motor and motor:IsA("Motor6D") and motor.Part0==root then table.insert(ignore,rig) end
            end
        end
        params.FilterDescendantsInstances=ignore
        local delta=position-origin
        if delta.Magnitude<0.001 then return false end
        local hit=workspace:Raycast(origin,delta,params)
        return hit==nil or hit.Instance:IsDescendantOf(entry.char)
            or (entry.rig and hit.Instance:IsDescendantOf(entry.rig))
    end
    local function eligible(entry)
        if entry.player==localPlayer or entry.player.Parent~=Players or helpers.ally(entry.player)
            or not aliveCharacter(entry.char,entry.player) then return false end
        if settings.ignoreFriends and (entry.friend or entry.friendKnown==false) then return false end
        if settings.ignoreProtected and ((helpers.protection and helpers.protection(entry.char,entry.player))
            or entry.char:FindFirstChildOfClass("ForceField")) then return false end
        -- A cached visual rig must still belong to the current live root.
        if not entry.root or not entry.root:IsDescendantOf(entry.char) then return false end
        if entry.rig~=entry.char then
            local torso=entry.rig and entry.rig:FindFirstChild("torso")
            local motor=torso and torso:FindFirstChild("JointMotor")
            if not motor or not motor:IsA("Motor6D") or motor.Part0~=entry.root or motor.Part1~=torso then return false end
        end
        return true
    end
    local function selectTarget(origin,localChar)
        local camera=workspace.CurrentCamera
        if not camera then return nil end
        local center=camera.ViewportSize*0.5
        local candidates={}
        for _,entry in pairs(app.entries) do
            if eligible(entry) then
                local head=entry.parts.head or entry.parts.Head
                local torso=entry.parts.torso or entry.parts.UpperTorso or entry.parts.Torso
                local parts={}
                if settings.hitbox~="Torso" and head then table.insert(parts,head) end
                if settings.hitbox~="Head" and torso then table.insert(parts,torso) end
                for _,part in ipairs(parts) do
                    if part.Parent and part:IsDescendantOf(workspace) then
                        local position=part.Position
                        local projected,onScreen=camera:WorldToViewportPoint(position)
                        local pixel=(Vector2.new(projected.X,projected.Y)-center).Magnitude
                        local distance=(position-origin).Magnitude
                        if onScreen and projected.Z>0 and pixel<=settings.fov and distance>0.01 then
                            local score=pixel/math.max(1,settings.fov)
                            if settings.priority=="Distance" then score=distance/1000
                            elseif settings.priority=="Health" then score=entry.hum.Health/math.max(1,entry.hum.MaxHealth)+score*0.001 end
                            if settings.sticky and aim.target and aim.target.entry.player==entry.player then score*=0.8 end
                            table.insert(candidates,{entry=entry,part=part,position=position,score=score,
                                pixel=pixel,distance=distance,screen=Vector2.new(projected.X,projected.Y)})
                        end
                    end
                end
            end
        end
        table.sort(candidates,function(a,b)
            if a.score==b.score then return a.entry.player.UserId<b.entry.player.UserId end
            return a.score<b.score
        end)
        aim.stats.candidates=#candidates
        for _,candidate in ipairs(candidates) do
            if not settings.visibleOnly or visible(origin,candidate.position,candidate.entry,localChar,camera) then
                return candidate
            end
        end
        return nil
    end
    local function restoreScope(scope)
        local weapon=scope.weapon
        if scope.spreadProxy and weapon.states.spread==scope.spreadProxy then weapon.states.spread=scope.originalSpread end
        if scope.recoilProxy and weapon.recoil==scope.recoilProxy then weapon.recoil=scope.originalRecoil end
